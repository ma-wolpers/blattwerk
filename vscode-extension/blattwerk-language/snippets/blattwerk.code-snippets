{
  "Task Block": {
    "scope": "blattwerk",
    "prefix": "bwtask",
    "body": [
      ":::task points=${1:2} work=${2:single} action=${3:read}",
      "${4:Aufgabentext}",
      ":::"
    ],
    "description": "Insert a Blattwerk task block"
  },
  "Answer Lines Block": {
    "scope": "blattwerk",
    "prefix": "bwanswerlines",
    "body": [
      ":::lines rows=${1:4}",
      "${2}",
      ":::"
    ],
    "description": "Insert a Blattwerk lines answer block"
  },
  "Help Block": {
    "scope": "blattwerk",
    "prefix": "bwhelp",
    "body": [
      ":::help title=\"${1:Hilfe}\" level=${2:1}",
      "${3:Hilfetext}",
      ":::"
    ],
    "description": "Insert a Blattwerk help card block"
  },
  "Frontmatter": {
    "scope": "blattwerk",
    "prefix": "bwfm",
    "body": [
      "---",
      "Titel: ${1:Titel}",
      "Fach: ${2:Fach}",
      "Thema: ${3:Thema}",
      "show_student_header: ${4:true}",
      "show_document_header: ${5:true}",
      "---",
      "",
      "${6}"
    ],
    "description": "Insert required Blattwerk frontmatter"
  },
  "Evaluation Table": {
    "scope": "blattwerk",
    "prefix": "bwevaluation",
    "body": [
      ":::evaluation level=${1|task,subtask|}:::"
    ],
    "description": "Insert a Blattwerk evaluation (grading) table"
  },
  "Operator Table": {
    "scope": "blattwerk",
    "prefix": "bwoperators",
    "body": [
      ":::operators scope=${1|previous,all,part|}:::"
    ],
    "description": "Insert a Blattwerk operator table (operators used before it, in the whole document, or in the current --hm part)"
  },
  "Aid Split Marker": {
    "scope": "blattwerk",
    "prefix": "bwhm",
    "body": [
      "--hm"
    ],
    "description": "Insert the exam aid split marker (Teil A / Teil B)"
  }
}
